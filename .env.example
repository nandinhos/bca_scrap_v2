APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================
# EMAIL - SMTP Configuração
# ============================================
# Driver: smtp, log (desenvolvimento), array (testes)
MAIL_MAILER=smtp
MAIL_HOST=smtp.fab.mil.br
MAIL_PORT=587
MAIL_USERNAME=<<INSIRA_USUARIO_SMTP>>
MAIL_PASSWORD=<<INSIRA_SENHA_SMTP_APP>>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<<INSIRA_EMAIL_REMETENTE>>
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=<<INSIRA_AWS_SECRET>>
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# Admin inicial (criado pelo UserSeeder)
# ============================================
ADMIN_NAME="Administrador"
ADMIN_EMAIL=<<INSIRA_EMAIL_ADMIN>>
ADMIN_PASSWORD=<<INSIRA_SENHA_ADMIN_FORTE>>

# ============================================
# Multi-Unidades — OM inicial
# ============================================
# Lidos pelo UnidadeSeeder/UserSeeder para criar a OM inicial da instalacao.
# Defaults genericos. Em prod, sobrescreva via .env ou install.sh.
# OM_SIGLA deve ser unica; OM_CODE e o codigo da OM (opcional).
OM_NAME=EXEMPLO1
OM_SIGLA=EXEMPLO1
OM_CODE=00001

# ============================================
# BCA — Fontes de dados e envio do compilado
# ============================================
# URLs das fontes do BCA na rede corporativa (intranet FAB / acessivel via VPN).
# Deixe os defaults se a sua OM usa as fontes padrão; sobrescreva se necessário.
BCA_BASE_URL=http://www.cendoc.intraer/sisbca/consulta_bca/
BCA_ICEA_URL=http://www.icea.intraer/app/arcadia/busca_bca/boletim_bca/
# E-mail da SAD que recebe o compilado diário (deixe vazio para desativar o envio).
# Preencha com o e-mail real da sua OM para ativar o compilado diário.
BCA_SAD_EMAIL=
# Parametros de busca (ajuste conforme a capacidade da rede da OM).
BCA_SEARCH_CHUNK_SIZE=10
BCA_SEARCH_TIMEOUT=10
BCA_SEARCH_RETRY=2
BCA_MAX_PDF_SIZE_MB=50

VITE_APP_NAME="${APP_NAME}"
